N = 8

def is_safe(board, row, col):
    # 1. Check the same column above
    for i in range(row):
        if board[i][col] == 1:
            return False
            
    # 2. Check the upper-left diagonal
    i, j = row - 1, col - 1
    while i >= 0 and j >= 0:
        if board[i][j] == 1:
            return False
        i -= 1
        j -= 1
        
    # 3. Check the upper-right diagonal
    i, j = row - 1, col + 1
    while i >= 0 and j < N:
        if board[i][j] == 1:
            return False
        i -= 1
        j += 1
        
    return True

def solve_n_queens(board, row):
    # Base Case: All queens are successfully placed
    if row == N:
        return True
        
    # Try placing a queen in every column of the current row
    for col in range(N):
        if is_safe(board, row, col):
            board[row][col] = 1  # Place the queen
            
            # Recursively try to place the rest of the queens
            if solve_n_queens(board, row + 1):
                return True
                
            # BACKTRACK: If placing it here didn't work, remove it
            board[row][col] = 0
            
    return False

# Driver Code
# Create an 8x8 matrix filled with 0s
board = [[0 for _ in range(N)] for _ in range(N)]

# REQUIREMENT: "having first Queen placed"
# We place the first queen at row 0, column 0
board[0][0] = 1

# Start the backtracking algorithm from row 1 (since row 0 is filled)
if solve_n_queens(board, 1):
    print("Final 8-Queens Matrix:")
    for r in board:
        print(r)
else:
    print("No solution exists")
