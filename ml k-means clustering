import pandas as pd
import matplotlib.pyplot as plt
from sklearn.cluster import KMeans

# 1. Load the dataset
# Note: 'latin1' encoding is often required for this specific Kaggle dataset to prevent read errors
df = pd.read_csv("sales_data_sample.csv", encoding='latin1')

# 2. Select Features for Clustering
# We use two numerical columns for easy 2D clustering and visualization
X = df[['QUANTITYORDERED', 'SALES']]

# 3. Determine the number of clusters using the Elbow Method
wcss = []

# Test K values from 1 to 10
for i in range(1, 11):
    kmeans = KMeans(n_clusters=i, random_state=42)
    kmeans.fit(X)
    wcss.append(kmeans.inertia_)  # inertia_ calculates the WCSS

# Plot the Elbow Graph
plt.plot(range(1, 11), wcss, marker='o')
plt.title('Elbow Method for Optimal K')
plt.xlabel('Number of Clusters (K)')
plt.ylabel('WCSS')
plt.show()

# 4. Implement K-Means with the optimal K
# Assume the elbow plot showed a sharp bend at K=3
optimal_k = 3
final_kmeans = KMeans(n_clusters=optimal_k, random_state=42)

# Fit the model and assign the cluster labels back to the original dataframe
df['Cluster'] = final_kmeans.fit_predict(X)

print("Clustering successful! Here is a sample of the clustered data:")
print(df[['QUANTITYORDERED', 'SALES', 'Cluster']].head())
